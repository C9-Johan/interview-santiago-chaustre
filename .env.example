# Copy to .env. All optional — the service runs fully offline with mock adapters by default.
PORT=3000

# Guesty webhook signing secret (Svix). When unset OR SKIP_SIGNATURE=true, verification is bypassed
# so the interviewer's unsigned fixtures work. Set both in production.
GUESTY_WEBHOOK_SECRET=
SKIP_SIGNATURE=true

# When set, the real OpenAI adapter (Vercel AI SDK) is used for classify + generate.
# When unset, a deterministic mock LLM runs instead (offline, used by tests).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Operator control — initial state of the auto-send kill switch.
AUTO_RESPONSE_ENABLED=true

# Burst debounce window (ms) per conversation. 0 disables (process immediately).
DEBOUNCE_MS=0
